# ========================================================
# FREELANCEX — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize values for your environment:
# cp .env.example .env
# ========================================================

# --- MariaDB / MySQL Configuration ---
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_USER=freelance_user
MYSQL_PASSWORD=your_secure_user_password_here
MYSQL_PORT=3306

# --- RabbitMQ Message Broker ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis Cache & Rate Limiting ---
REDIS_PORT=6379

# --- Application Gateway & Security ---
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Frontend Application ---
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3000/api
