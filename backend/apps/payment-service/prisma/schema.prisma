datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/payment"
}

model Wallet {
  id               String        @id @default(uuid()) @db.Char(36)
  userId           String        @unique @map("user_id") @db.Char(36)
  availableBalance Decimal       @default(0.00) @map("available_balance") @db.Decimal(12, 2)
  escrowBalance    Decimal       @default(0.00) @map("escrow_balance") @db.Decimal(12, 2)
  updatedAt        DateTime      @updatedAt @map("updated_at")
  transactions     Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Char(36)
  walletId    String            @map("wallet_id") @db.Char(36)
  milestoneId String?           @map("milestone_id") @db.Char(36)
  amount      Decimal           @db.Decimal(12, 2)
  feeAmount   Decimal           @default(0.00) @map("fee_amount") @db.Decimal(12, 2)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  wallet      Wallet            @relation(fields: [walletId], references: [id])

  @@map("transactions")
  @@index([walletId], name: "idx_tx_wallet")
  @@index([milestoneId], name: "idx_tx_milestone")
}

model IdempotencyRecord {
  key             String   @id @db.VarChar(255)
  responsePayload Json?    @map("response_payload")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("idempotency_records")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model WithdrawalRequest {
  id            String           @id @default(uuid()) @db.Char(36)
  userId        String           @map("user_id") @db.Char(36)
  amount        Decimal          @db.Decimal(12, 2)
  bankInfo      Json             @map("bank_info")
  status        WithdrawalStatus @default(PENDING)
  adminNote     String?          @map("admin_note") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("withdrawal_requests")
  @@index([userId], name: "idx_withdrawal_user")
  @@index([status], name: "idx_withdrawal_status")
}
